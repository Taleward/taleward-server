diff --git a/app/verwaltung/templates/discord.html b/app/verwaltung/templates/discord.html
new file mode 100644
index 0000000..6663aa3
--- /dev/null
+++ b/app/verwaltung/templates/discord.html
@@ -0,0 +1,45 @@
+{% extends "basis.html" %}
+{% block titel %}{{ _("Discord-Bot") }}{% endblock %}
+{% block inhalt %}
+<h1>{{ _("Discord-Bot") }}</h1>
+<p class="hilfe">{{ _("Der Bot nimmt Online-Runden im Sprachkanal auf, je Person eine eigene Spur. Aufgenommen wird nur, wer zugestimmt hat. Die Spielleitung verbindet ihre Kampagne selbst mit ihrem Discord-Server.") }}</p>
+{% if not faktor %}<div class="hinweis">{{ _("Einschalten und Schlüssel brauchen den zweiten Faktor.") }} <a href="/verwaltung/anmeldung#zweiter-faktor">{{ _("Zweiten Faktor einrichten") }}</a></div>{% endif %}
+
+<div class="karte" id="schalter">
+  <h2>{{ _("Schalter") }}</h2>
+  <p>{% if an %}<span class="marke-status marke-status--gut">{{ _("eingeschaltet") }}</span>{% else %}<span class="marke-status">{{ _("aus") }}</span>{% endif %}</p>
+  <form method="post" action="/verwaltung/discord/schalter">
+    <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="an" value="{{ '0' if an else '1' }}">
+    {% if an %}<button class="tw-btn tw-btn--secondary" type="submit">{{ _("Ausschalten") }}</button>
+    {% else %}<button class="tw-btn tw-btn--primary" type="submit" {% if not faktor %}disabled{% endif %}>{{ _("Einschalten") }}</button>{% endif %}
+  </form>
+  <p class="hilfe">{{ _("Ausgeschaltet antwortet der Server dem Bot nicht, und die App zeigt nichts davon.") }}</p>
+</div>
+
+<div class="karte" id="schluessel">
+  <h2>{{ _("Schlüssel für den Bot") }}</h2>
+  {% if neu_klartext %}
+  <div class="meldung" role="status">
+    <p><strong>{{ _("Neuer Schlüssel „{name}“ – nur jetzt sichtbar:", name=neu_name) }}</strong></p>
+    <p class="kopierzeile"><code class="ganz">{{ neu_klartext }}</code></p>
+    <p class="hilfe">{{ _("In die Einstellungen des Bots eintragen (TALEWARD_BOT_SCHLUESSEL). Nicht in Chats oder Bildschirmfotos zeigen.") }}</p>
+  </div>
+  {% endif %}
+  {% if schluessel %}
+  <ul class="liste-av">
+  {% for k in schluessel %}
+    <li><span><strong>{{ k.name }}</strong> · {{ zeit(k.created_at) }}{% if k.revoked_at %} · <span class="marke-status">{{ _("widerrufen") }}</span>{% endif %}</span>
+      {% if not k.revoked_at %}<form method="post" action="/verwaltung/discord/schluessel/{{ k.id }}/widerrufen">
+        <input type="hidden" name="csrf" value="{{ csrf }}">
+        <button class="tw-btn tw-btn--secondary tw-btn--klein" type="submit" {% if not faktor %}disabled{% endif %}>{{ _("Widerrufen") }}</button></form>{% endif %}</li>
+  {% endfor %}
+  </ul>
+  <p class="hilfe">{{ _("Nach dem Widerrufen ruhen die Verbindungen dieses Schlüssels, bis die Spielleitungen neu verbinden.") }}</p>
+  {% else %}<p class="leise">{{ _("Noch kein Schlüssel.") }}</p>{% endif %}
+  <form class="formular formular--zeile" method="post" action="/verwaltung/discord/schluessel">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    <label>{{ _("Name") }} <input type="text" name="name" maxlength="80" value="Discord-Bot"></label>
+    <button class="tw-btn tw-btn--secondary" type="submit" {% if not faktor %}disabled{% endif %}>{{ _("Schlüssel erzeugen") }}</button>
+  </form>
+</div>
+{% endblock %}
diff --git a/app/verwaltung/templates/discord_link.html b/app/verwaltung/templates/discord_link.html
new file mode 100644
index 0000000..90c4cf9
--- /dev/null
+++ b/app/verwaltung/templates/discord_link.html
@@ -0,0 +1,28 @@
+{% extends "basis.html" %}
+{% block titel %}{% if art == "verbinden" %}{{ _("Kampagne mit Discord verbinden") }}{% else %}{{ _("Der Aufnahme zustimmen") }}{% endif %}{% endblock %}
+{% block inhalt %}
+<div class="anmeldung">
+  {% include "_kopf_marke.html" %}
+  <div class="karte">
+    {% if gueltig %}
+    {% if art == "verbinden" %}
+    <h2>{{ _("Kampagne mit Discord verbinden") }}</h2>
+    <p>{{ _("Öffne den Link in Taleward und wähle dort die Kampagne. Das geht nur mit dem Konto, das mit deinem Discord-Konto verknüpft ist.") }}</p>
+    {% else %}
+    <h2>{{ _("Der Aufnahme zustimmen") }}</h2>
+    <p>{{ _("Die Runde im Discord wird aufgenommen. Deine Stimme kommt nur dazu, wenn du zustimmst – in Taleward oder hier im Browser.") }}</p>
+    {% endif %}
+    <p class="leise">{{ _("Server: {name} · {betreiber}", name=angaben.server_name, betreiber=angaben.server_operator) }}</p>
+    <div class="knopfstapel">
+      <a class="tw-btn tw-btn--primary" href="{{ app_link }}">{{ _("In Taleward öffnen") }}</a>
+      {% if browser_link %}<a class="tw-btn tw-btn--secondary" href="{{ browser_link }}" rel="noopener">{% if art == "zustimmen" %}{{ _("Im Browser zustimmen") }}{% else %}{{ _("Im Browser öffnen") }}{% endif %}</a>{% endif %}
+    </div>
+    <p class="hilfe">{{ _("Der Link gilt 15 Minuten und nur einmal.") }}</p>
+    {% else %}
+    <h2>{{ _("Dieser Link gilt nicht") }}</h2>
+    <p>{{ _("Hol dir im Discord mit dem Befehl einen neuen Link.") }}</p>
+    {% endif %}
+  </div>
+  <p class="leise zentriert">{% set ds = angaben.privacy_policy_url|datenschutz_link %}{% if ds %}<a href="{{ ds }}" rel="noopener">{{ _("Datenschutz") }}</a> · {% endif %}{% include "_sprachen.html" %}</p>
+</div>
+{% endblock %}
