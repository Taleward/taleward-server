Date: Wed, 14 Oct 2026 11:08:23 +0200
Subject: [PATCH] Server 0.4.92

Charakterboegen je Spieler: bis zu 50 einstellbar, Voreinstellung 3. Fassung 0.4.92.
---
 app/services.py                        | 4 ++--
 app/unterlagen.py                      | 4 ++--
 app/verwaltung/i18n.py                 | 1 +
 app/verwaltung/templates/guthaben.html | 3 ++-
 pyproject.toml                         | 2 +-
 tests/test_aktualisierung.py           | 2 +-
 tests/test_assistent.py                | 2 +-
 tests/test_modellablage.py             | 2 +-
 tests/test_server_0491.py              | 9 +++++++++
 tests/test_worker_app.py               | 2 +-
 uv.lock                                | 2 +-
 11 files changed, 22 insertions(+), 11 deletions(-)

diff --git a/app/services.py b/app/services.py
index 00516f4..1ec5a82 100644
--- a/app/services.py
+++ b/app/services.py
@@ -200,5 +200,5 @@ def campaign_summary(db: Session, c: Campaign, me: Member) -> schemas.CampaignSu
 def _bogen_grenzen(db: Session, c: Campaign) -> schemas.SheetLimitsOut:
     """0.4.19: die Grenzen, die für Charakterbögen von Spielern gelten (wie in `unterlagen._bogen_grenzen_pruefen`):
-    höchstens 3 Bögen, mit eingeschalteter Abrechnung die ggf. kleinere Zahl der SL; ausgewertet werden höchstens
+    3 Bögen, mit eingeschalteter Abrechnung die Zahl der SL (0–50, Voreinstellung 3); ausgewertet werden höchstens
     20 Seiten, mit Abrechnung höchstens so viele, wie ein Bogen haben darf."""
     from app import abrechnung
@@ -208,5 +208,5 @@ def _bogen_grenzen(db: Session, c: Campaign) -> schemas.SheetLimitsOut:
     if grenzen is None:
         return schemas.SheetLimitsOut(max_sheets=MAX_BOEGEN, max_pages=MAX_SEITEN)
-    return schemas.SheetLimitsOut(max_sheets=min(MAX_BOEGEN, grenzen[1]), max_pages=min(MAX_SEITEN, grenzen[0]))
+    return schemas.SheetLimitsOut(max_sheets=grenzen[1], max_pages=min(MAX_SEITEN, grenzen[0]))
 
 
diff --git a/app/unterlagen.py b/app/unterlagen.py
index b54e97c..d7c7de8 100644
--- a/app/unterlagen.py
+++ b/app/unterlagen.py
@@ -211,6 +211,6 @@ def _bogen_grenzen_pruefen(db: Session, campaign_id: str, member_id: str, art: s
     grenzen = abrechnung.bogen_grenzen(db, c) if c is not None else None
     spieler = m is not None and m.role != "gm"
-    # 0.4.18: höchstens 3 Bögen je Mitglied; mit Abrechnung für Spieler die (ggf. kleinere) Grenze der SL
-    anzahl_max = min(MAX_BOEGEN, grenzen[1]) if grenzen is not None and spieler else MAX_BOEGEN
+    # 0.4.18: 3 Bögen je Mitglied; mit Abrechnung gilt für Spieler die Zahl der SL (0–50, Voreinstellung 3; Benjamin 14.10.)
+    anzahl_max = grenzen[1] if grenzen is not None and spieler else MAX_BOEGEN
     if schon >= anzahl_max:
         raise errors.conflict("sheet_limit", "sheet_limit_reached", anzahl=anzahl_max)
diff --git a/app/verwaltung/i18n.py b/app/verwaltung/i18n.py
index 95d0d23..d0d7a62 100644
--- a/app/verwaltung/i18n.py
