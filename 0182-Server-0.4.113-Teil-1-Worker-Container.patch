 # Grafikkarte braucht der Server den NVIDIA-Treiber und das nvidia-container-toolkit – die CUDA-Bibliotheken selbst
 # bringt PyTorch mit, deshalb reicht ein schlankes Grundbild.
+#
+# Installiert wird nur mit Prüfsummen (wie in der Worker-App): Pakete aus uv.lock, PyTorch aus
+# deploy/pytorch-pruefsummen.txt, uv und das Bauwerkzeug aus festen Listen unter deploy/.
+
+# Erste Stufe: nur die Paketlisten. Sie läuft bei jeder neuen uv.lock (schnell); die große Installation darunter
+# kommt aus dem Zwischenspeicher, solange die Listen gleich bleiben.
+FROM python:3.11-slim-bookworm AS listen
+ARG TORCH_BACKEND=cu128
+COPY deploy/uv-werkzeug.txt /tmp/uv-werkzeug.txt
+RUN pip install --no-cache-dir --no-deps --require-hashes -r /tmp/uv-werkzeug.txt
+WORKDIR /quelle
+COPY pyproject.toml uv.lock ./
+COPY deploy/ki_pakete.py deploy/pytorch-pruefsummen.txt deploy/bauwerkzeug.txt ./deploy/
+RUN uv export --frozen --format requirements-txt --extra ki --no-dev --no-emit-project --no-header --no-annotate \
+      -q -o /tmp/ki.txt \
+ && python deploy/ki_pakete.py /tmp/ki.txt deploy/pytorch-pruefsummen.txt deploy/bauwerkzeug.txt "$TORCH_BACKEND" /listen
+
 FROM python:3.11-slim-bookworm
 
