@@ -100,5 +126,8 @@ _FIGUR = re.compile(r"\b(?:ich spiele|ich spiel|spiele ich|mein charakter heißt
 _SL = re.compile(r"\b(?:ich leite|ich bin (?:heute )?(?:euer |eure |der |die |dein |deine )?(?:spielleit\w*|sl|meister\w*|"
