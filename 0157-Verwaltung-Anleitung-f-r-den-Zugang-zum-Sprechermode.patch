diff --git a/app/verwaltung/i18n.py b/app/verwaltung/i18n.py
index f5c90d3..bf70883 100644
--- a/app/verwaltung/i18n.py
+++ b/app/verwaltung/i18n.py
@@ -1118,4 +1118,9 @@ EN: dict[str, str] = {
     "z. B. Vereinsregister, Amtsgericht, Nummer": "e.g. register of associations, court, number",
     "z. B. Vorstand: Name, Name": "e.g. board: name, name",
+    "So bekommst du den Zugangsschlüssel – einmalig und kostenlos:": "How to get the access key – once and free of charge:",
+    "Auf huggingface.co ein Konto anlegen.": "Create an account on huggingface.co.",
+    "Angemeldet die Seite des Sprechermodells öffnen und den Bedingungen zustimmen.": "While signed in, open the speaker model's page and accept the conditions.",
+    "Seite des Sprechermodells": "Speaker model page",
+    "Unter „Settings“ → „Access Tokens“ einen Schlüssel mit dem Recht „Read“ anlegen, kopieren und hier einfügen.": "Under “Settings” → “Access Tokens”, create a key with the “Read” permission, copy it and paste it here.",
 }
 
diff --git a/app/verwaltung/templates/transkription.html b/app/verwaltung/templates/transkription.html
index 9656597..3699147 100644
--- a/app/verwaltung/templates/transkription.html
+++ b/app/verwaltung/templates/transkription.html
@@ -232,4 +232,12 @@
   {% endif %}
   <h3>{{ _("Zugang zu Hugging Face") }}</h3>
+  {% if not hf_ende and not modell.stand %}
+  <p>{{ _("So bekommst du den Zugangsschlüssel – einmalig und kostenlos:") }}</p>
+  <ol class="schritte">
+    <li>{{ _("Auf huggingface.co ein Konto anlegen.") }} <a href="https://huggingface.co/join" rel="noopener noreferrer" target="_blank">huggingface.co/join</a></li>
+    <li>{{ _("Angemeldet die Seite des Sprechermodells öffnen und den Bedingungen zustimmen.") }} <a href="https://huggingface.co/pyannote/speaker-diarization-community-1" rel="noopener noreferrer" target="_blank">{{ _("Seite des Sprechermodells") }}</a></li>
+    <li>{{ _("Unter „Settings“ → „Access Tokens“ einen Schlüssel mit dem Recht „Read“ anlegen, kopieren und hier einfügen.") }} <a href="https://huggingface.co/settings/tokens" rel="noopener noreferrer" target="_blank">huggingface.co/settings/tokens</a></li>
+  </ol>
+  {% endif %}
   <p>{% if hf_ende %}<span class="marke-status marke-status--gut">{{ _("hinterlegt") }}</span> {{ _("endet auf …{ende}", ende=hf_ende) }}{% else %}<span class="marke-status">{{ _("nicht hinterlegt") }}</span>{% endif %}</p>
   <form class="formular" method="post" action="/verwaltung/transkription/hf">
diff --git a/tests/test_assistent.py b/tests/test_assistent.py
index 325c1b1..d2ba579 100644
--- a/tests/test_assistent.py
+++ b/tests/test_assistent.py
@@ -42,5 +42,5 @@ def test_einrichtung_nur_mit_code(client, dbs):
     assert r.status_code == 303 and r.headers["location"] == "/verwaltung/assistent/verein"
     assert "tw_verwaltung" in r.headers["set-cookie"]
-    assert "Euer Verein" in client.get("/verwaltung/assistent/verein").text
+    assert "Wer betreibt diesen Server?" in client.get("/verwaltung/assistent/verein").text
     # Code verbraucht, Server eingerichtet
     client.cookies.clear()
diff --git a/tests/test_server_04105.py b/tests/test_server_04105.py
index 11aeb85..be066f7 100644
--- a/tests/test_server_04105.py
+++ b/tests/test_server_04105.py
@@ -107,2 +107,8 @@ def test_sicherung_im_einzelplatz_nur_ein_satz(client, dbs, admin, monkeypatch):
     seite = client.get("/verwaltung/").text
     assert "im Taleward-Programm unter Einstellungen → Sicherung" in seite and "Jetzt sichern" not in seite
+
+
+def test_anleitung_fuer_den_zugang_zum_sprechermodell(client, dbs, admin):  # noqa: F811
+    seite = client.get("/verwaltung/transkription").text
+    assert "einmalig und kostenlos" in seite and "huggingface.co/pyannote/speaker-diarization-community-1" in seite
+    assert 'id="hf"' in seite  # Sprungziel für „Stimmen erkennen einrichten“ im Programm
