+    assert szenen_text([{"von": 0.0, "bis": 720.0, "text": "A."}]).startswith("– Szene 1 (0:00–12:00) –\n\nA.")
+    assert kapitelprobe.KAPITELWEGE == sm.KAPITELWEGE == ("standard", "szenen", "vorbereitet")
