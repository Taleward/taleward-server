+
+def test_datenschutz_vorlage_nennt_die_pruefsumme(dbs):
+    from app import rechtstexte
+
+    _modus(dbs, "guthaben")
+    assert not any("Prüfsumme" in t for t in rechtstexte.datenschutz_abschnitt(dbs))
