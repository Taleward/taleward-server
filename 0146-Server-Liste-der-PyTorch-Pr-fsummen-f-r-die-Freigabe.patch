@@ -0,0 +1,112 @@
+"""Prüfsummen der PyTorch-Dateien für eine Server-Fassung festhalten (läuft im Ablauf „Fassung markieren“).
+
+Die Worker-App installiert torch, torchaudio und torchvision in der Variante für die Grafikkarte (bzw. „nur
+Prozessor“) vom PyTorch-Verzeichnis. Für diese Dateien stehen keine Prüfsummen in uv.lock. Dieses Skript liest die
+Versionen aus uv.lock, holt aus dem Verzeichnis die SHA-256 aller passenden Dateien (Python 3.11, Windows und Linux)
+und schreibt sie in `pytorch-pruefsummen.txt`. Die Datei hängt am Release der Fassung und wird mit der Freigabe
+unterschrieben; die Worker-App installiert PyTorch dann nur noch mit genau diesen Prüfsummen.
+
+Aufbau, eine Zeile je Variante:  <variante> <paket>==<fassung> --hash=sha256:<hex> [--hash=sha256:<hex> …]
+Nur Standardbibliothek, ohne Abhängigkeiten.
+
+    python3 deploy/pytorch_pruefsummen.py uv.lock pytorch-pruefsummen.txt
+"""
+from __future__ import annotations
+
+import re
+import sys
+import tomllib
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+VERZEICHNIS = "https://download.pytorch.org/whl"
+VARIANTEN = ("cu128", "cpu")  # wie TORCH_BACKEND in der Worker-App (taleward_worker/motor.py) plus „nur Prozessor“
+PAKETE = ("torch", "torchaudio", "torchvision")
+PYTHON = "cp311"
+# Ohne diese Systeme ist die Liste unvollständig (Windows und Linux auf x86_64)
+PFLICHT = ("win_amd64", "x86_64")
+MAX_SEITE = 4 * 1024 * 1024
+_HREF = re.compile(r'href="([^"]+)"')
+_SHA = re.compile(r"^[0-9a-f]{64}$")
+
+
+class Fehler(Exception):
+    pass
+
+
+def fassungen(lock: str) -> dict[str, str]:
+    """Versionen von torch, torchaudio und torchvision aus uv.lock."""
+    daten = tomllib.loads(lock)
+    gefunden: dict[str, str] = {}
+    for p in daten.get("package", []):
+        name = str(p.get("name", ""))
+        if name in PAKETE:
+            if name in gefunden and gefunden[name] != p.get("version"):
+                raise Fehler(f"{name} steht in mehreren Fassungen in uv.lock")
+            gefunden[name] = str(p.get("version"))
+    fehlt = [n for n in PAKETE if n not in gefunden]
+    if fehlt:
+        raise Fehler("nicht in uv.lock: " + ", ".join(fehlt))
+    return gefunden
+
+
+def seite_laden(adresse: str) -> str:
+    anfrage = urllib.request.Request(adresse, headers={"User-Agent": "Taleward-Freigabe"})
+    with urllib.request.urlopen(anfrage, timeout=60) as antwort:  # noqa: S310 – feste https-Adresse
+        roh = antwort.read(MAX_SEITE + 1)
+    if len(roh) > MAX_SEITE:
+        raise Fehler(f"Seite zu groß: {adresse}")
+    return roh.decode("utf-8", errors="replace")
+
+
+def dateien(html: str, paket: str, fassung: str) -> dict[str, list[tuple[str, str]]]:
+    """Aus einer Seite des Verzeichnisses: volle Fassung (mit lokalem Teil, z. B. 2.8.0+cu128) → [(Datei, SHA-256)],
+    nur Räder für Python 3.11."""
+    muster = re.compile(rf"^{re.escape(paket)}-{re.escape(fassung)}(\+[A-Za-z0-9.]+)?-{PYTHON}-{PYTHON}-([A-Za-z0-9_.]+)\.whl$")
+    ergebnis: dict[str, list[tuple[str, str]]] = {}
+    for href in _HREF.findall(html):
+        adresse, _, fragment = href.partition("#")
+        name = urllib.parse.unquote(adresse.rsplit("/", 1)[-1])
+        m = muster.match(name)
+        if not m or not fragment.startswith("sha256="):
+            continue
+        sha = fragment[len("sha256="):].lower()
+        if not _SHA.match(sha):
+            raise Fehler(f"Prüfsumme unlesbar: {name}")
+        ergebnis.setdefault(fassung + (m.group(1) or ""), []).append((name, sha))
+    return ergebnis
+
+
+def erzeugen(lock: str, laden=None) -> str:
+    laden = laden or seite_laden
+    zeilen = ["# Prüfsummen der PyTorch-Dateien (aus uv.lock und " + VERZEICHNIS + "), Python 3.11"]
+    for variante in VARIANTEN:
+        for paket, fassung in fassungen(lock).items():
+            gefunden = dateien(laden(f"{VERZEICHNIS}/{variante}/{paket}/"), paket, fassung)
+            eigene = gefunden.get(f"{fassung}+{variante}", [])
+            for system in PFLICHT:
+                if not any(name.endswith(f"{system}.whl") for name, _ in eigene):
+                    raise Fehler(f"{paket} {fassung}+{variante}: keine Datei für {system}")
+            for voll in sorted(gefunden):
+                hashes = sorted({sha for _, sha in gefunden[voll]})
+                zeilen.append(f"{variante} {paket}=={voll} " + " ".join(f"--hash=sha256:{h}" for h in hashes))
+    return "\n".join(zeilen) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 3:
+        print(__doc__.strip().splitlines()[-1].strip(), file=sys.stderr)
+        return 2
+    try:
+        text = erzeugen(Path(argv[1]).read_text(encoding="utf-8"))
+    except (Fehler, OSError, ValueError) as e:
+        print(f"Fehler: {e}", file=sys.stderr)
+        return 1
+    Path(argv[2]).write_text(text, encoding="utf-8")
+    print(text, end="")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tests/test_pytorch_pruefsummen.py b/tests/test_pytorch_pruefsummen.py
new file mode 100644
index 0000000..579f47c
--- /dev/null
+++ b/tests/test_pytorch_pruefsummen.py
@@ -0,0 +1,79 @@
+"""Prüfsummen der PyTorch-Dateien für die Freigabe (deploy/pytorch_pruefsummen.py)."""
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+WURZEL = Path(__file__).resolve().parents[1]
+
+
+def _modul():
+    spec = importlib.util.spec_from_file_location("pytorch_pruefsummen", WURZEL / "deploy" / "pytorch_pruefsummen.py")
+    m = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(m)
+    return m
+
+
+def _seite(paket, fassung, variante, systeme=("win_amd64", "manylinux_2_28_x86_64"), extra=""):
+    zeilen = []
+    for i, s in enumerate(systeme):
+        h = f"{abs(hash((paket, variante, s))) % 10**60:064d}"
+        name = f"{paket}-{fassung}%2B{variante}-cp311-cp311-{s}.whl"
+        zeilen.append(f'<a href="/whl/{variante}/{name}#sha256={h}">{name}</a><br/>')
+    zeilen.append(f'<a href="/whl/{variante}/{paket}-{fassung}%2B{variante}-cp312-cp312-win_amd64.whl#sha256={"1" * 64}">x</a>')
+    zeilen.append(f'<a href="/whl/{variante}/{paket}-9.9.9%2B{variante}-cp311-cp311-win_amd64.whl#sha256={"2" * 64}">x</a>')
+    return "<html><body>" + "".join(zeilen) + extra + "</body></html>"
+
+
+def test_versionen_aus_der_echten_uv_lock():
+    m = _modul()
+    f = m.fassungen((WURZEL / "uv.lock").read_text(encoding="utf-8"))
+    assert set(f) == {"torch", "torchaudio", "torchvision"} and all(f.values())
+
+
+def test_liste_je_variante_nur_python_311(monkeypatch):
+    m = _modul()
+    lock = (WURZEL / "uv.lock").read_text(encoding="utf-8")
+    f = m.fassungen(lock)
+    seiten = []
+
+    def laden(adresse):
+        seiten.append(adresse)
+        variante, paket = adresse.rstrip("/").split("/")[-2:]
+        return _seite(paket, f[paket], variante)
+    text = m.erzeugen(lock, laden)
+    zeilen = [z for z in text.splitlines() if not z.startswith("#")]
+    assert len(zeilen) == 6 and len(seiten) == 6
+    assert all(s.startswith("https://download.pytorch.org/whl/") for s in seiten)
+    torch_cu = next(z for z in zeilen if z.startswith("cu128 torch=="))
+    assert torch_cu.startswith(f"cu128 torch=={f['torch']}+cu128 --hash=sha256:") and torch_cu.count("--hash=") == 2
+    assert "1" * 64 not in text and "2" * 64 not in text  # andere Python-Fassung, andere torch-Fassung
+
+
+def test_ohne_windows_datei_keine_liste():
+    m = _modul()
+    lock = (WURZEL / "uv.lock").read_text(encoding="utf-8")
+    f = m.fassungen(lock)
+
+    def laden(adresse):
+        variante, paket = adresse.rstrip("/").split("/")[-2:]
+        return _seite(paket, f[paket], variante, systeme=("manylinux_2_28_x86_64",))
+    with pytest.raises(m.Fehler):
+        m.erzeugen(lock, laden)
+
+
+def test_kaputte_pruefsumme_bricht_ab():
+    m = _modul()
+    html = '<a href="/whl/cpu/torch-2.8.0%2Bcpu-cp311-cp311-win_amd64.whl#sha256=xyz">x</a>'
+    with pytest.raises(m.Fehler):
+        m.dateien(html, "torch", "2.8.0")
+
+
+def test_aufruf_ohne_netz_meldet_fehler(tmp_path, monkeypatch, capsys):
+    m = _modul()
+
+    def kein_netz(adresse):
+        raise OSError("kein Netz")
+    monkeypatch.setattr(m, "seite_laden", kein_netz)
+    ziel = tmp_path / "liste.txt"
+    assert m.main(["x", str(WURZEL / "uv.lock"), str(ziel)]) == 1 and not ziel.exists()
