diff --git a/app/einrichtung.py b/app/einrichtung.py
index d01881c..5fc0a3f 100644
--- a/app/einrichtung.py
+++ b/app/einrichtung.py
@@ -41,4 +41,8 @@ def code_erzeugen(db: Session, neu: bool = False) -> str:
 
 def code_pruefen(db: Session, code: str) -> bool:
+    from app.config import get_settings
+
+    if get_settings().taleward_einzelplatz:
+        return False  # Einzelplatz: das erste Konto legt nur das Programm mit seinem Startschlüssel an
     soll = meta_lesen(db, "einrichtung.code")
     ist = (code or "").strip().upper().replace(" ", "")
@@ -84,4 +88,10 @@ def beim_start(db: Session) -> str | None:
     if meta_lesen(db, ERSTER_START) is None:  # S6/S21.3: Frist läuft ab dem ersten Start, nicht ab jedem Neustart
         meta_schreiben(db, ERSTER_START, str(time.time()))
+    from app.config import get_settings
+
+    if get_settings().taleward_einzelplatz:
+        db.commit()
+        log.warning("Einzelplatz: Das erste Konto legt das Programm an (ohne Einrichtungscode).")
+        return None
     code = code_erzeugen(db)
     from app.einstellungen import angaben
diff --git a/app/einstellungen.py b/app/einstellungen.py
index 6e25912..cce2414 100644
--- a/app/einstellungen.py
+++ b/app/einstellungen.py
@@ -69,4 +69,10 @@ def angaben(db: Session) -> Angaben:
     werte["server_name"] = werte["server_name"] or s.server_name
     werte["server_operator"] = werte["server_operator"] or s.server_operator
+    if s.taleward_einzelplatz:  # immer die aktuelle Heimnetz-Adresse des PCs (Einladungen, QR-Code, publicUrl)
+        from app.einzelplatz import eigener_datenschutz, oeffentliche_url
+
+        werte["public_url"] = oeffentliche_url()
+        if eigener_datenschutz(werte["privacy_policy_url"]):  # eigene Seite: mit der aktuellen Adresse
