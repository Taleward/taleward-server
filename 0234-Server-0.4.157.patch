+
+def ablaufdaten(db: Session) -> dict:
+    """Eingerichtete Dienste mit eingetragenem Ablaufdatum."""
+    aus = {}
+    for d in ABLAUF_DIENSTE:
+        a = ablauf(db, d)
+        if a is not None and konfig(db, d).eingerichtet:
+            aus[d] = a
+    return aus
