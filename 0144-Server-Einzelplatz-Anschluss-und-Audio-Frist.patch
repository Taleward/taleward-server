diff --git a/app/audio.py b/app/audio.py
index 5660cbe..aaa9c1b 100644
--- a/app/audio.py
+++ b/app/audio.py
@@ -10,4 +10,5 @@ import subprocess
 import sys
 import tempfile
+import threading
 import time
 import wave
@@ -107,12 +108,23 @@ def _dekodieren_in(quelle: Path, w, rest_s: float) -> int:
               "-map", "0:a:0", "-ac", "1", "-ar", str(SAMPLE_RATE), "-t", f"{rest_s + 1:.3f}",
               "-f", "s16le", "-acodec", "pcm_s16le", "-"]
-    ende = time.monotonic() + _zeitgrenze(quelle)
+    frist = _zeitgrenze(quelle)
+    ende = time.monotonic() + frist
     geschrieben = 0
     rest = b""
     with tempfile.TemporaryFile() as fehler:
         p = subprocess.Popen(befehl, stdout=subprocess.PIPE, stderr=fehler, stdin=subprocess.DEVNULL, **extra)
+        abgelaufen = threading.Event()
+
+        def _abbrechen():  # Wächter: auch wenn ffmpeg hängt, ohne etwas zu schreiben (read() käme sonst nie zurück)
+            abgelaufen.set()
+            if p.poll() is None:
+                p.kill()
+
+        waechter = threading.Timer(frist, _abbrechen)
+        waechter.daemon = True
+        waechter.start()
         try:
             while True:
-                if time.monotonic() > ende:
+                if time.monotonic() > ende or abgelaufen.is_set():
                     raise AudioFehler("audio_timeout", "ffmpeg hat zu lange gebraucht.", True)
                 block = p.stdout.read(1 << 20)
@@ -128,8 +140,11 @@ def _dekodieren_in(quelle: Path, w, rest_s: float) -> int:
             raise AudioFehler("audio_timeout", "ffmpeg hat zu lange gebraucht.", True) from e
         finally:
+            waechter.cancel()
             if p.poll() is None:
                 p.kill()
                 p.wait()
             p.stdout.close()
+        if abgelaufen.is_set():
+            raise AudioFehler("audio_timeout", "ffmpeg hat zu lange gebraucht.", True)
         if code != 0 or geschrieben == 0:
             fehler.seek(0)
diff --git a/app/cli.py b/app/cli.py
index a3701f7..70cca6b 100644
--- a/app/cli.py
+++ b/app/cli.py
@@ -1151,8 +1151,8 @@ def einzelplatz(port: int = typer.Option(8000)):
     konfig = uvicorn.Config("app.main:app", host="0.0.0.0", port=port, proxy_headers=False, forwarded_allow_ips="",
                             server_header=False, access_log=False)
-    uvicorn.Server(konfig).run(sockets=[einzelplatz_anschluss(port)])
+    uvicorn.Server(konfig).run(sockets=einzelplatz_anschluesse(port))
 
 
-def einzelplatz_anschluss(port: int):
+def einzelplatz_anschluss(port: int, familie=None, adresse: str = "0.0.0.0"):
     """Anschluss für den Einzelplatz selbst belegen. Unter Windows exklusiv (SO_EXCLUSIVEADDRUSE): Sonst könnte ein
     anderes Programm desselben PCs zusätzlich 127.0.0.1:<port> belegen und Startschlüssel und Passwort abfangen.
@@ -1160,5 +1160,6 @@ def einzelplatz_anschluss(port: int):
     import socket
 
-    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    familie = socket.AF_INET if familie is None else familie
+    s = socket.socket(familie, socket.SOCK_STREAM)
     exklusiv = getattr(socket, "SO_EXCLUSIVEADDRUSE", None)
     try:
@@ -1167,5 +1168,7 @@ def einzelplatz_anschluss(port: int):
         else:
             s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
-        s.bind(("0.0.0.0", port))
+        if familie == getattr(socket, "AF_INET6", None):
+            s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
+        s.bind((adresse, port))
     except OSError:
         s.close()
@@ -1174,4 +1177,27 @@ def einzelplatz_anschluss(port: int):
 
 
+# Fehler beim Belegen von [::1], die nur heißen „dieser PC hat kein IPv6“ – dann kann auch niemand sonst dort lauschen
+_OHNE_IPV6 = {97, 99, 10047, 10049}  # EAFNOSUPPORT, EADDRNOTAVAIL (Linux) bzw. WSAEAFNOSUPPORT, WSAEADDRNOTAVAIL
+
+
+def einzelplatz_anschluesse(port: int) -> list:
+    """IPv4 für alle Netze und zusätzlich [::1] – Browser fragen „localhost“ oft zuerst über IPv6. Belegt ein anderes
+    Programm schon [::1]:<port>, startet der Einzelplatz nicht (sonst landeten Anfragen an localhost dort). Ins Heimnetz
+    geht weiter nur IPv4."""
+    import errno
+    import socket
+
+    v4 = einzelplatz_anschluss(port)
+    if not socket.has_ipv6:
+        return [v4]
+    try:
+        return [v4, einzelplatz_anschluss(v4.getsockname()[1], socket.AF_INET6, "::1")]
+    except OSError as e:
+        if e.errno in _OHNE_IPV6 or e.errno in (errno.EAFNOSUPPORT, errno.EADDRNOTAVAIL):
+            return [v4]
+        v4.close()
+        raise
+
+
 if __name__ == "__main__":
     app()
