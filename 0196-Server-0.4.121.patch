diff --git a/deploy/website-neu-laden.sh b/deploy/website-neu-laden.sh
new file mode 100755
index 0000000..dd70509
--- /dev/null
+++ b/deploy/website-neu-laden.sh
@@ -0,0 +1,66 @@
+#!/bin/bash
+# Optional: statische Website neben dem Server (docs/BETRIEB.md, „Website mitliefern“).
+# Übernimmt die Caddy-Regeln der Website aus <WEBSITE_ORDNER>/_caddy/*.caddy und lädt Caddy neu – ohne Neustart.
+# Aufgerufen per sudo vom Nutzer, der die Website hochlädt (eingerichtet von website-zugang.sh), ohne Argumente.
+# Die Regeln dürfen nur Dateien aus /srv/website ausliefern (Prüfung unten). Lehnt Caddy sie ab, bleiben die alten
+# Regeln auf der Platte und in Betrieb. Test der Prüfung allein:  website-neu-laden.sh --pruefen DATEI
+set -euo pipefail
+ZIEL=${TALEWARD_ZIEL:-/opt/taleward}
+WURZEL=/srv/website              # so sieht Caddy den Website-Ordner (docker-compose.yml)
+MAX_BYTES=262144
+
+regeln_pruefen() {
+  local datei=$1
+  if [ ! -f "$datei" ] || [ -L "$datei" ] || [ "$(wc -c <"$datei")" -gt "$MAX_BYTES" ]; then
+    echo "Abgelehnt: $(basename "$datei") ist keine normale Datei oder zu groß." >&2
+    return 1
+  fi
+  # Nichts, was über statisches Ausliefern hinausgeht: keine weiteren Dateien einbinden, nichts weiterleiten,
+  # keine Platzhalter für Umgebung oder Dateien, keine Protokolle, Zertifikate oder Verwaltung, kein „..“
+  if grep -nEi '(^|[[:space:]])(import|reverse_proxy|php_fastcgi|forward_auth|fs|storage|admin|acme_ca|acme_dns|tls|log|templates|invoke|metrics|tracing)([[:space:]]|\{|$)|\{(env|file|system)\.|\{\$|\.\.' "$datei" >&2; then
+    echo "Abgelehnt: $(basename "$datei") enthält nicht erlaubte Angaben (Zeilen oben)." >&2
+    return 1
+  fi
+  # „root“ nur innerhalb des Website-Ordners
+  if grep -nE '^[[:space:]]*root([[:space:]]|$)' "$datei" \
+     | grep -vE ":[[:space:]]*root([[:space:]]+(\*|@[A-Za-z0-9_-]+|/[^[:space:]]*))?[[:space:]]+$WURZEL(/[^[:space:]]*)?[[:space:]]*$" >&2; then
+    echo "Abgelehnt: „root“ muss in $WURZEL liegen (Zeilen oben)." >&2
+    return 1
+  fi
+}
+
+if [ "${1:-}" = "--pruefen" ]; then
+  regeln_pruefen "${2:?Datei fehlt}"
+  exit
+fi
+[ "$#" -eq 0 ] || { echo "Ohne Argumente aufrufen." >&2; exit 2; }
+
+ORDNER=$(sed -n 's/^WEBSITE_ORDNER=//p' "$ZIEL/.env" | tail -1)
+if [ -z "$ORDNER" ] || [ ! -d "$ORDNER" ] || [ -L "$ORDNER/_caddy" ]; then
+  echo "Kein Website-Ordner eingerichtet (WEBSITE_ORDNER in $ZIEL/.env)." >&2
+  exit 1
+fi
+REGELN="$ZIEL/website-caddy"
+mkdir -p "$REGELN"
+NEU=$(mktemp -d) ALT=$(mktemp -d)
+trap 'rm -rf "$NEU" "$ALT"' EXIT
+shopt -s nullglob
+# Erst kopieren (Verknüpfungen bleiben Verknüpfungen), dann die Kopie prüfen – was geprüft ist, wird auch übernommen
+for f in "$ORDNER"/_caddy/*.caddy; do
+  cp -P -- "$f" "$NEU/"
+done
+for f in "$NEU"/*; do
+  regeln_pruefen "$f"
+done
+cp -a "$REGELN"/. "$ALT"/
+rm -f "$REGELN"/*.caddy
+for f in "$NEU"/*.caddy; do install -m 644 "$f" "$REGELN/"; done
+cd "$ZIEL"
+if docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile; then
+  echo "Caddy neu geladen."
+  exit 0
+fi
+rm -f "$REGELN"/*.caddy
+cp -a "$ALT"/. "$REGELN"/
+echo "Caddy hat die neuen Regeln abgelehnt – die bisherigen bleiben in Betrieb." >&2
+exit 1
diff --git a/deploy/website-zugang.sh b/deploy/website-zugang.sh
new file mode 100755
index 0000000..880295a
--- /dev/null
+++ b/deploy/website-zugang.sh
@@ -0,0 +1,77 @@
+#!/bin/bash
+# Optional, einmalig: eine statische Website neben dem Server über denselben Caddy ausliefern
+# (docs/BETRIEB.md, „Website mitliefern“). Legt den Nutzer „website“ an, der per SSH genau zweierlei darf:
+# Dateien in den Website-Ordner hochladen (rsync, nur dorthin) und „neu-laden“ (Caddy-Regeln prüfen und übernehmen).
+# Aufruf auf dem Server:  sudo bash /opt/taleward/website-zugang.sh
+# Erneut aufrufen ersetzt den Schlüssel (z. B. nach einem Wechsel).
+set -euo pipefail
+ZIEL=${TALEWARD_ZIEL:-/opt/taleward}
+NUTZER=website
+EMPFANG=/usr/local/bin/taleward-website-empfang
+NEULADEN=/usr/local/sbin/taleward-website-neu-laden
+
+abbruch() { echo "Abbruch: $*" >&2; exit 1; }
+[ "$(id -u)" = 0 ] || abbruch "bitte mit sudo starten."
+[ -f "$ZIEL/.env" ] && [ -f "$ZIEL/website-neu-laden.sh" ] || abbruch "kein Taleward-Server in $ZIEL (erst install.sh)."
+
+ALT=$(sed -n 's/^WEBSITE_ORDNER=//p' "$ZIEL/.env" | tail -1)
+read -r -p "Ordner für die Website [${ALT:-/srv/website}]: " EINGABE </dev/tty || true
+ORDNER=${EINGABE:-${ALT:-/srv/website}}
+[[ "$ORDNER" =~ ^/(srv|var/www)/[A-Za-z0-9._-]+$ ]] && [[ "$ORDNER" != *..* ]] \
+  || abbruch "bitte einen Ordner direkt unter /srv oder /var/www, z. B. /srv/website."
+
+echo "Öffentlicher SSH-Schlüssel für das Hochladen (eine Zeile, beginnt mit „ssh-ed25519“):"
+read -r SCHLUESSEL </dev/tty
+[[ "$SCHLUESSEL" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+=*(\ [A-Za-z0-9@._-]*)?$ ]] \
+  || abbruch "das sieht nicht nach einem öffentlichen ssh-ed25519-Schlüssel aus."
+
+command -v rsync >/dev/null 2>&1 || apt-get install -y -q rsync >/dev/null
+[ -x /usr/bin/rrsync ] || abbruch "rrsync fehlt (gehört ab Ubuntu 24.04 zum Paket rsync)."
+
+id "$NUTZER" >/dev/null 2>&1 || useradd --system --create-home --shell /bin/sh "$NUTZER"
+passwd -l "$NUTZER" >/dev/null
+mkdir -p "$ORDNER"
+chown "$NUTZER:$NUTZER" "$ORDNER"
+chmod 755 "$ORDNER"
+
+install -m 755 -o root -g root "$ZIEL/website-neu-laden.sh" "$NEULADEN"
+cat > "$EMPFANG" <<SKRIPT
+#!/bin/sh
+# Einziger Befehl für den Nutzer „$NUTZER“ per SSH (authorized_keys: command=…): hochladen oder neu laden
+case "\${SSH_ORIGINAL_COMMAND:-}" in
+  "rsync --server "*) exec /usr/bin/rrsync -wo $ORDNER ;;
+  neu-laden) exec sudo -n $NEULADEN ;;
+  *) echo "Nicht erlaubt – nur rsync und „neu-laden“." >&2; exit 1 ;;
+esac
+SKRIPT
+chown root:root "$EMPFANG"
+chmod 755 "$EMPFANG"
+
+REGEL=$(mktemp)
+echo "$NUTZER ALL=(root) NOPASSWD: $NEULADEN" > "$REGEL"
+visudo -cqf "$REGEL" || abbruch "sudo-Regel ungültig."
+install -m 440 -o root -g root "$REGEL" /etc/sudoers.d/taleward-website
+rm -f "$REGEL"
+
+HEIM=$(getent passwd "$NUTZER" | cut -d: -f6)
+install -d -m 755 -o root -g root "$HEIM/.ssh"
+printf 'command="%s",restrict %s\n' "$EMPFANG" "$SCHLUESSEL" > "$HEIM/.ssh/authorized_keys"
+chown root:root "$HEIM/.ssh/authorized_keys"
+chmod 644 "$HEIM/.ssh/authorized_keys"
+
+if grep -q '^WEBSITE_ORDNER=' "$ZIEL/.env"; then
+  sed -i "s#^WEBSITE_ORDNER=.*#WEBSITE_ORDNER=$ORDNER#" "$ZIEL/.env"
+else
+  echo "WEBSITE_ORDNER=$ORDNER" >> "$ZIEL/.env"
+fi
+mkdir -p "$ZIEL/website-caddy"
+(cd "$ZIEL" && docker compose up -d caddy >/dev/null)
+
+IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')
+echo
+echo "Fertig. Für das Hochladen (z. B. als Secrets im Website-Repository):"
+echo "  Adresse:        ${IP:-<IP dieses Servers>}"
+echo "  Nutzer:         $NUTZER"
+echo "  known_hosts:    ${IP:-<IP>} $(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)"
+echo "Hochladen:  rsync -rlz --delete --delay-updates dist/ $NUTZER@${IP:-<IP>}:"
+echo "Neu laden:  ssh $NUTZER@${IP:-<IP>} neu-laden"
diff --git a/docs/BETRIEB.md b/docs/BETRIEB.md
index 9009a0a..7125554 100644
--- a/docs/BETRIEB.md
+++ b/docs/BETRIEB.md
@@ -221,4 +221,42 @@ Eine Sicherung ist eine vollständige Kopie der Datenbank, also auch aller Kampa
 aufbewahren. Wiederherstellen: siehe [INSTALLATION.md](../INSTALLATION.md#sicherung).
 
+## Auf einen anderen Server umziehen
+
+Alles, was mitmuss, liegt in `/opt/taleward`: der Ordner `daten` (Datenbank, Bilder, Unterlagen, Aufnahmen,
+Hörproben, Sicherungen, Geheimnis für die Anmeldung), die `.env` und – falls vorhanden – `docker-compose.override.yml`.
+Die Zertifikate holt Caddy auf dem neuen Server selbst, sobald die Domain dorthin zeigt; wer vorher testen will, nimmt
+das Docker-Volume `taleward_caddy-daten` mit. Ablauf:
+
+1. Neuer Server: `install.sh` wie bei der Ersteinrichtung (gleiche Domain), danach `sudo docker compose stop`.
+2. Alter Server: `sudo docker compose stop server`, dann `daten`, `.env` (und ggf. die Override-Datei) als Archiv
+   packen, z. B. `sudo tar czf /root/taleward-umzug.tgz -C /opt/taleward daten .env`, und auf den neuen Server kopieren.
+3. Neuer Server: Archiv in `/opt/taleward` auspacken (der alte `daten`-Ordner wird ersetzt), dann
+   `sudo chown -R 1000:1000 daten` und `sudo docker compose up -d --build`.
+4. Domain (A- und ggf. AAAA-Eintrag) auf den neuen Server umstellen. Konten, Anmeldungen, Worker-Kopplungen und
+   Apps bleiben gültig, weil sich die Adresse nicht ändert.
+5. Den alten Server erst abschalten, wenn der neue läuft; vorher dort `sudo systemctl disable --now
+   taleward-aktualisieren.timer`.
+
+## Website mitliefern (optional)
+
+Wer neben dem Server eine statische Website betreibt, kann sie über denselben Caddy ausliefern. Ohne Einrichtung
+ändert sich nichts.
+
+1. Auf dem Server einmal `sudo bash /opt/taleward/website-zugang.sh`. Das Skript fragt nach dem Ordner (Vorschlag
+   `/srv/website`) und nach dem öffentlichen SSH-Schlüssel, mit dem hochgeladen wird. Es legt den Nutzer `website` an,
+   der per SSH nur zweierlei darf: mit `rsync` in genau diesen Ordner schreiben und `neu-laden`. Am Ende zeigt es die
+   Angaben für das Hochladen (Adresse, `known_hosts`-Zeile).
+2. Hochladen: `rsync -rlz --delete --delay-updates dist/ website@SERVER:` und danach `ssh website@SERVER neu-laden`.
+3. Die Website bringt ihre Caddy-Regeln selbst mit: Dateien `_caddy/*.caddy` im hochgeladenen Ordner, mit
+   Site-Blöcken für ihre Domains (ohne globalen Block). Caddy sieht den Ordner als `/srv/website`; `root` muss darin
+   liegen. Erlaubt ist nur statisches Ausliefern (Kopfzeilen, Umleitungen, Antworten, `file_server` usw.) – nicht
+   erlaubt sind u. a. `import`, `reverse_proxy`, `log`, `tls`, `templates` und Platzhalter für Umgebung oder Dateien.
+   `neu-laden` prüft die Regeln, übernimmt sie und lädt Caddy ohne Neustart neu. Lehnt Caddy sie ab, bleiben die
+   bisherigen in Betrieb, und der Befehl endet mit einem Fehler. Den Ordner `_caddy` selbst sollte die Website mit
+   einer Regel vor dem Ausliefern schützen (z. B. `respond /_caddy/* 404`).
+
+Nach jedem erfolgreichen Update räumt der Server ungenutzte Docker-Bilder auf, die älter als eine Woche sind (ohne
+eingebauten Worker auch alte Bau-Zwischenstände) – wichtig bei kleinen Platten.
+
 ## Updates für App und Worker
 
