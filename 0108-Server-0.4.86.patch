@@ -0,0 +1,34 @@
+{# Karte „Dein zweiter Faktor“ (S4) – seit 0.4.86 unter Verwaltung → Anmeldung #}
+<div class="karte" id="zweiter-faktor">
+  <h2>{{ _("Dein zweiter Faktor") }}</h2>
+  {% if faktor.codes %}
+  <p>{{ _("Der zweite Faktor ist eingeschaltet. Schreib dir diese Wiederherstellungscodes auf oder drucke sie aus. Jeder gilt einmal, falls das Handy fehlt. Sie werden nur jetzt angezeigt.") }}</p>
+  <ul class="codeliste">{% for c in faktor.codes %}<li><code>{{ c }}</code></li>{% endfor %}</ul>
+  {% elif faktor.neu %}
+  <p>{{ _("1. Öffne deine Authenticator-App (zum Beispiel Aegis, Google Authenticator oder Microsoft Authenticator) und scanne den QR-Code.") }}</p>
+  <figure class="einladung__qr"><img src="{{ faktor.neu.qr }}" width="222" height="222" alt="{{ _('QR-Code für die Authenticator-App') }}"></figure>
+  <p class="hilfe">{{ _("Scannen geht nicht? Schlüssel von Hand eingeben:") }} <code>{{ faktor.neu.geheim }}</code></p>
+  <form class="formular formular--zeile" method="post" action="/verwaltung/zweiter-faktor/bestaetigen">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    <label>{{ _("2. Code aus der App") }} <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required maxlength="10"></label>
+    <button class="tw-btn tw-btn--primary" type="submit">{{ _("Einschalten") }}</button>
+  </form>
+  {% elif faktor.aktiv %}
+  <p><span class="marke-status marke-status--gut">{{ _("eingeschaltet") }}</span> {{ _("Noch {n} Wiederherstellungscodes übrig.", n=faktor.codes_uebrig) }}</p>
+  <details><summary>{{ _("Zweiten Faktor ausschalten") }}</summary>
+    <form class="formular formular--zeile" method="post" action="/verwaltung/zweiter-faktor/aus">
+      <input type="hidden" name="csrf" value="{{ csrf }}">
+      <label>{{ _("Passwort") }} <input type="password" name="password" autocomplete="current-password" required></label>
+      <label>{{ _("Code aus der App") }} <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required maxlength="20"></label>
+      <button class="tw-btn tw-btn--secondary tw-btn--klein" type="submit">{{ _("Ausschalten") }}</button>
+    </form>
+  </details>
+  {% else %}
+  <p>{{ _("Mit einem zweiten Faktor braucht die Anmeldung in der Verwaltung neben dem Passwort einen Code aus einer Authenticator-App auf dem Handy. Wer dein Passwort kennt, kommt dann trotzdem nicht hinein.") }}</p>
+  <form class="formular formular--zeile" method="post" action="/verwaltung/zweiter-faktor/beginnen">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    <label>{{ _("Passwort zur Bestätigung") }} <input type="password" name="password" autocomplete="current-password" required></label>
+    <button class="tw-btn tw-btn--primary" type="submit">{{ _("Einrichten") }}</button>
+  </form>
+  {% endif %}
+</div>
