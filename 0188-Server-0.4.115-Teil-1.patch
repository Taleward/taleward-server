+.menue[open] summary { margin-bottom:var(--space-1); }
+.menue__liste { display:grid; gap:var(--space-1); }
+.menue__liste a { color:var(--on-tinte); text-decoration:none; padding:var(--space-1) var(--space-3); border-radius:var(--radius-md);
