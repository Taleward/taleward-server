+
+/* Symbole (Lucide-Formen) */
+.icon { display:inline-block; vertical-align:-4px; }
+
+/* Übersicht: erst die Antwort in Worten, dann die Zahlen in einem Kasten */
+.lage { font:500 18px/26px var(--font-sans); margin:calc(-1 * var(--space-3)) 0 var(--space-6); }
+.lage--achtung { color:var(--siegel-text); }
+.kennzahlen { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); margin:0 0 var(--space-6);
+  background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius-md); box-shadow:var(--shadow-card); overflow:hidden; }
+.kennzahlen > div { padding:var(--space-3) var(--space-4); border-right:1px solid var(--line); border-bottom:1px solid var(--line);
