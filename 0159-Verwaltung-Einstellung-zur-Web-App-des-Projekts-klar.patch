Subject: [PATCH 159/162] Verwaltung: Einstellung zur Web-App des Projekts
 klarer beschrieben

---
 app/verwaltung/i18n.py                      | 4 ++--
 app/verwaltung/templates/einstellungen.html | 4 ++--
 tests/test_webapp.py                        | 2 +-
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/app/verwaltung/i18n.py b/app/verwaltung/i18n.py
index bf70883..ac8597c 100644
--- a/app/verwaltung/i18n.py
+++ b/app/verwaltung/i18n.py
@@ -165,6 +165,6 @@ EN: dict[str, str] = {
     "Für lange Aufnahmen am Handy die App verwenden.": "For long recordings on a phone, use the app.",
     "Web-App": "Web app",
-    "Die Web-App auf {adresse} darf diesen Server nutzen": "The web app at {adresse} may use this server",
-    "Dann können Mitglieder Taleward auch im Browser nutzen. Die Website sieht dabei keine Inhalte – der Browser spricht direkt mit diesem Server. Nur mit HTTPS.": "Members can then use Taleward in the browser too. The website never sees any content – the browser talks to this server directly. HTTPS only.",
+    "Auch die Web-App des Projekts Taleward ({adresse}) darf diesen Server nutzen": "The Taleward project’s web app ({adresse}) may use this server too",
+    "Die eigene Web-App dieses Servers (unter /app/) geht immer. Die Web-App des Projekts ist ein Angebot von Taleward, nicht von diesem Server; sie sieht keine Inhalte – der Browser spricht direkt mit diesem Server. Ausschalten, wenn Mitglieder nur die eigene nutzen sollen. Nur mit HTTPS.": "This server’s own web app (under /app/) always works. The project’s web app is offered by Taleward, not by this server; it never sees any content – the browser talks to this server directly. Turn it off if members should only use this server’s own. HTTPS only.",
     "Updates": "Updates",
     "Dieser Server": "This server",
diff --git a/app/verwaltung/templates/einstellungen.html b/app/verwaltung/templates/einstellungen.html
index 893259e..7a378b9 100644
--- a/app/verwaltung/templates/einstellungen.html
+++ b/app/verwaltung/templates/einstellungen.html
@@ -83,6 +83,6 @@
     <input type="hidden" name="web_zentral_feld" value="1">
     <label class="haken"><input type="checkbox" name="web_zentral" value="an" {% if web_zentral %}checked{% endif %}>
-      <span>{{ _("Die Web-App auf {adresse} darf diesen Server nutzen", adresse=zentrale_webapp) }}</span></label>
-    <span class="hilfe">{{ _("Dann können Mitglieder Taleward auch im Browser nutzen. Die Website sieht dabei keine Inhalte – der Browser spricht direkt mit diesem Server. Nur mit HTTPS.") }}</span>
+      <span>{{ _("Auch die Web-App des Projekts Taleward ({adresse}) darf diesen Server nutzen", adresse=zentrale_webapp) }}</span></label>
+    <span class="hilfe">{{ _("Die eigene Web-App dieses Servers (unter /app/) geht immer. Die Web-App des Projekts ist ein Angebot von Taleward, nicht von diesem Server; sie sieht keine Inhalte – der Browser spricht direkt mit diesem Server. Ausschalten, wenn Mitglieder nur die eigene nutzen sollen. Nur mit HTTPS.") }}</span>
     {% endif %}
     <label>{{ _("Weitere Adressen für die Web-App") }} <textarea name="web_herkuenfte" rows="2" maxlength="2000" placeholder="https://…">{{ web_herkuenfte }}</textarea>
diff --git a/tests/test_webapp.py b/tests/test_webapp.py
