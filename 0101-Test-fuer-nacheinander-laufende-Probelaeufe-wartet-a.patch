From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Tue, 13 Oct 2026 20:20:53 +0200
Subject: [PATCH 101/102] Test fuer nacheinander laufende Probelaeufe wartet
 auf den Faden

"fertig" steht schon in der Datei, waehrend der Faden noch die Reihe freigibt.
---
 tests/test_cloud_0461.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tests/test_cloud_0461.py b/tests/test_cloud_0461.py
index 93050f5..cd39a1c 100644
--- a/tests/test_cloud_0461.py
+++ b/tests/test_cloud_0461.py
@@ -212,3 +212,7 @@ def test_probelaeufe_nacheinander(client, world, dbs, tmp_path, admin):  # noqa:
         time.sleep(0.05)
     assert probelauf.lesen(pid).zustand == "fertig"
+    # „fertig“ steht schon in der Datei, wenn der Faden noch die Reihe freigibt – kurz auf sein Ende warten
+    for t in threading.enumerate():
+        if t.name.startswith("probelauf-"):
+            t.join(timeout=5)
     assert not any(t.name.startswith("probelauf-") and t.is_alive() for t in threading.enumerate())
