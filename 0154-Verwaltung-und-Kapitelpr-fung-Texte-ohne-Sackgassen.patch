             self.letzte_pruefung_vorher, self.letzte_pruefung_nachher = befund, []
             self.letzte_relationen_vorher, self.letzte_relationen_nachher = [], []
@@ -2722,5 +2728,5 @@ class Ablauf:
                     r["text"], pruefung["revised"] = neu, True
