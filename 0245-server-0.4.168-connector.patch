+  {% for p in protokoll %}<tr><td>{{ zeit(p.zeit) }}</td>
+    <td>{% if p.art == "senden" %}{{ _("geändert") }}{% elif p.art == "lesen" %}{{ _("gelesen") }}{% elif p.art == "freigabe" %}{{ _("freigegeben") }}{% elif p.art == "verbunden" %}{{ _("verbunden") }}{% else %}{{ _("Übersicht") }}{% endif %}</td>
+    <td>{{ p.pfad }}</td><td>{{ p.status }}</td></tr>{% endfor %}
+  </tbody></table></div>
