+    <label>{{ _("Nur aus diesen Netzen") }} <input type="text" name="netze" maxlength="400" value="{{ netze }}">
+      <span class="hilfe">{{ _("Mit Komma getrennt. Voreingestellt ist das Netz, aus dem Claude anfragt. Leer heißt: von überall.") }}</span></label>
+    <div class="knopfzeile"><button class="tw-btn tw-btn--secondary" type="submit">{{ _("Speichern") }}</button></div>
+  </form>
+</details>
+{% endif %}
+
+<details class="karte" id="protokoll">
+  <summary><h2 class="summary-titel">{{ _("Letzte Schritte des Connectors") }}</h2></summary>
+  {% if protokoll %}
