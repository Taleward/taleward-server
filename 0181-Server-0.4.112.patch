diff --git a/app/config.py b/app/config.py
index b44c028..868a0a6 100644
--- a/app/config.py
+++ b/app/config.py
@@ -91,4 +91,7 @@ class Settings(BaseSettings):
     # das es Strg+C schicken könnte). Nur im Einzelplatz wirksam.
     einzelplatz_stopp_datei: Path | None = None
+    # Taleward Desktop: Herkunft der Programmoberfläche (http://localhost:<Anschluss>), die App und Verwaltung in einem
+    # Rahmen zeigt. Nur im Einzelplatz und nur genau in dieser Form wirksam; sonst bleibt jede Einbettung verboten.
+    einzelplatz_huelle: str = ""
     update_check: bool = True
     update_app_repo: str = "Taleward/taleward-app"
@@ -193,8 +196,20 @@ def _einzelplatz(s: Settings) -> None:
     s.einrichtung_im_heimnetz = False
     s.worker_server_url = f"http://127.0.0.1:{s.einzelplatz_port}"
+    s.einzelplatz_huelle = huelle_pruefen(s.einzelplatz_huelle, s.einzelplatz_port)
     if (urlsplit(s.worker_llm_url).hostname or "") not in ("localhost", "127.0.0.1", "::1"):
         s.worker_llm_url = "http://127.0.0.1:11434"  # Ollama hat keine Anmeldung – nie über das Netz
 
 
+def huelle_pruefen(wert: str, server_port: int) -> str:
+    """Nur `http://localhost:<Anschluss>` (1024–65535, nicht der des Servers), sonst leer – kein Platzhalter, kein
+    anderer Name, kein Pfad."""
+    import re
+
+    m = re.fullmatch(r"http://localhost:([1-9][0-9]{3,4})", (wert or "").strip())
+    if not m or not 1024 <= int(m.group(1)) <= 65535 or int(m.group(1)) == server_port:
+        return ""
+    return f"http://localhost:{int(m.group(1))}"
+
+
 @lru_cache
 def get_settings() -> Settings:
@@ -202,4 +217,6 @@ def get_settings() -> Settings:
     if s.taleward_einzelplatz:
         _einzelplatz(s)
+    else:
+        s.einzelplatz_huelle = ""
     if s.jwt_secret == STANDARD_GEHEIMNIS or len(s.jwt_secret) < 32:
         s.jwt_secret = _geheimnis(s.data_dir)
diff --git a/app/verwaltung/router.py b/app/verwaltung/router.py
index 4c07df6..9f319fa 100644
--- a/app/verwaltung/router.py
+++ b/app/verwaltung/router.py
@@ -1639,4 +1639,14 @@ HSTS = "max-age=31536000"
 
 
+def einbettbar(kopfzeilen: dict[str, str], huelle: str) -> dict[str, str]:
+    """Taleward Desktop (Einzelplatz): Einbetten nur durch genau die Programmoberfläche dieses PCs erlauben."""
+    if not huelle:
+        return kopfzeilen
+    neu = {k: v for k, v in kopfzeilen.items() if k != "X-Frame-Options"}
+    neu["Content-Security-Policy"] = neu["Content-Security-Policy"].replace("frame-ancestors 'none'",
+                                                                            f"frame-ancestors {huelle}")
+    return neu
+
+
 def einbinden(app: FastAPI) -> None:
     from app.verwaltung import anmeldung, assistent, uebergabe
@@ -1679,8 +1689,11 @@ def einbinden(app: FastAPI) -> None:
         elif pfad.startswith(("/verwaltung", "/einladung", "/datenschutz", "/passwort", "/konto/", "/konto-loeschen",
                               "/auth/oidc/", "/guthaben")):  # auch die Bestätigungsseite der Anmeldung mit Diensten
-            for k, v in SICHERHEITS_KOPFZEILEN.items():
+            kopf = SICHERHEITS_KOPFZEILEN
+            if pfad.startswith("/verwaltung"):  # Verwaltung im Rahmen von Taleward Desktop
+                kopf = einbettbar(kopf, get_settings().einzelplatz_huelle)
+            for k, v in kopf.items():
                 antwort.headers.setdefault(k, v)
         elif pfad == "/app" or pfad.startswith("/app/"):
-            for k, v in WEBAPP_KOPFZEILEN.items():
+            for k, v in einbettbar(WEBAPP_KOPFZEILEN, get_settings().einzelplatz_huelle).items():
                 antwort.headers.setdefault(k, v)
         if request.url.scheme == "https":  # hinter Caddy (X-Forwarded-Proto); im Heimnetz ohne TLS nicht
