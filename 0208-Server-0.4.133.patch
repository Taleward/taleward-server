+    if abs((jetzt or time.time()) - t) > STRIPE_TOLERANZ:
+        return False
+    erwartet = hmac.new(geheimnis.encode(), f"{t}.".encode() + roh, hashlib.sha256).hexdigest()
+    return any(hmac.compare_digest(erwartet, s) for s in teile.get("v1", []))
