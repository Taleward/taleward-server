+        "paypal_webhook_id": typer.prompt("PayPal: Webhook-ID des Live-Kontos"),
+    }
+    luecken = zl.an(db, neu)
+    db.commit()
+    if luecken:
+        typer.echo("Nicht eingeschaltet. Es fehlt:", err=True)
+        for z in luecken:
+            typer.echo(f"  - {z}", err=True)
+        raise typer.Exit(1)
