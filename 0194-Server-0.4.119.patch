+    if wurzel.is_dir():
+        ids |= {p.name for p in wurzel.iterdir() if p.is_dir()}
+    for sid in sorted(ids):
         letzte = db.scalar(select(Upload.completed_at).where(Upload.session_id == sid, Upload.state == "completed")
