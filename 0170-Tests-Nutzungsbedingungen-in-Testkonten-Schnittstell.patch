diff --git a/tests/conftest.py b/tests/conftest.py
index 3946b6b..83a0852 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -59,6 +59,10 @@ def make_user(dbs):
     from app.cli import _neues_konto
 
-    def _make(username: str, name: str | None = None, password: str = "geheim123"):
+    def _make(username: str, name: str | None = None, password: str = "geheim123", terms: bool = True):
         u = _neues_konto(dbs, username.lower(), name or username.capitalize(), password)
+        if terms:  # 0.4.22: Testkonten haben den Nutzungsbedingungen zugestimmt (sonst nur Lesen)
+            from app.db import utcnow
+
+            u.terms_accepted_version, u.terms_accepted_at = 1, utcnow()
         dbs.commit()
         return u
diff --git a/tests/contract.py b/tests/contract.py
index 845dcd7..6d0dd77 100644
--- a/tests/contract.py
+++ b/tests/contract.py
@@ -33,4 +33,5 @@ OPTIONAL_FIELDS = {"characterBackstory", "gmNotes", "hiddenFromMemberIds", "memb
                    "formerHolderMemberId",  # 0.4.9: nur für die SL
                    "assignedMemberId",  # 0.4.10: erst nach der Bestätigung der Stimmen
+                   "gmWarnings",  # 0.4.21: nur für die SL, für Spieler weggelassen
                    "user"}
 
@@ -94,4 +95,6 @@ class Contract:
         if status == 426 and body and json.loads(body).get("code") == "app_outdated":
             return  # 0.3.9: kann jede API-Anfrage treffen (außer /info, /health)
+        if status == 403 and body and json.loads(body).get("code") == "terms_required":
+            return  # 0.4.22: kann jede ändernde Anfrage treffen, solange die Zustimmung zu den Bedingungen fehlt
         if status == 409 and body and json.loads(body).get("code") == "feature_unavailable":
             # Mit der App vereinbart: noch nicht fertige Funktionen antworten überall so.
