From df07a3339bfe59017bfc5edc0125d945366ece2f Mon Sep 17 00:00:00 2001
From: Tinkerworkss <Tinkerworkss@users.noreply.github.com>
Date: Tue, 13 Oct 2026 14:01:28 +0200
Subject: [PATCH] Tests auch unter Windows: Zeitzonen-Daten, Dateien als UTF-8

- tzdata als Abhaengigkeit nur unter Windows (dort fehlt die Zeitzonen-Datenbank).
- Tests lesen und schreiben Dateien ausdruecklich als UTF-8.
- Die Pruefung des Update-Skripts laeuft nur unter Linux.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013CssQZuRBCpCJdqrK2dJvj
---
 engine-requirements.txt          |  4 +++-
 pyproject.toml                   |  1 +
 tests/test_aktualisierung.py     |  4 ++--
 tests/test_assistent.py          |  4 ++--
 tests/test_eingaben_pruefen.py   |  8 ++++----
 tests/test_eingebauter_worker.py |  8 ++++----
 tests/test_freigabe.py           |  5 +++--
 tests/test_modellablage.py       |  4 ++--
 tests/test_modelle.py            |  2 +-
 tests/test_probelauf.py          |  6 +++---
 tests/test_verwaltung2.py        | 10 +++++-----
 tests/test_worker_app.py         |  2 +-
 uv.lock                          |  2 ++
 13 files changed, 33 insertions(+), 27 deletions(-)

diff --git a/engine-requirements.txt b/engine-requirements.txt
index f289f27..4765c3f 100644
--- a/engine-requirements.txt
+++ b/engine-requirements.txt
@@ -496,5 +496,7 @@ typing-inspection==0.4.4
     #   pydantic-settings
 tzdata==2026.4 ; sys_platform == 'emscripten' or sys_platform == 'win32'
-    # via pandas
+    # via
+    #   pandas
+    #   taleward-server
 urllib3==2.8.0
     # via requests
diff --git a/pyproject.toml b/pyproject.toml
index 892ff31..b734b41 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -21,4 +21,5 @@ dependencies = [
     "pypdf>=5",
     "segno>=1.6",
+    "tzdata>=2024.1; sys_platform == 'win32'",  # Windows hat keine eigene Zeitzonen-Datenbank (Europe/Berlin)
 ]
 
diff --git a/tests/test_aktualisierung.py b/tests/test_aktualisierung.py
index 1ff242b..2cc2693 100644
