diff --git a/app/benachrichtigung.py b/app/benachrichtigung.py
index 5287a2e..e678d24 100644
--- a/app/benachrichtigung.py
+++ b/app/benachrichtigung.py
@@ -109,9 +109,16 @@ def _ntfy(k: Konfig, titel: str, text: str, wichtig: bool) -> None:
 
 
-def _email(k: Konfig, titel: str, text: str) -> None:
+def _email(k: Konfig, titel: str, text: str, antwort_an: str | None = None) -> None:
+    """Text-Mail über den eingestellten Mailserver. `antwort_an`: Antworten gehen dorthin statt an den Absender
+    (z. B. eine noreply-Adresse) – nur eine einzelne gültige Adresse."""
+    from app import mail
+
     nachricht = EmailMessage()
     nachricht["Subject"] = titel
     nachricht["From"] = k.email_von or k.smtp_user or k.email_an
     nachricht["To"] = k.email_an
+    if antwort_an and mail.gueltig(antwort_an) and antwort_an.lower() != (nachricht["From"] or "").lower():
+        nachricht["Reply-To"] = antwort_an
+    nachricht["Auto-Submitted"] = "auto-generated"  # automatische Mail: keine Abwesenheitsnotizen zurück
     nachricht["Date"] = formatdate(localtime=True)
     nachricht["Message-ID"] = make_msgid(domain=(nachricht["From"].split("@")[-1] or None))
diff --git a/app/mail.py b/app/mail.py
index fb45b88..e795231 100644
--- a/app/mail.py
+++ b/app/mail.py
@@ -38,9 +38,13 @@ def senden(db: Session, an: str, betreff: str, text: str) -> None:
     from app.benachrichtigung import VersandFehler, _email, konfig
 
+    from app.einstellungen import angaben
+
     k = konfig(db)
     if not k.smtp_host:
         raise MailFehler("Kein Mailserver eingerichtet.")
+    # 0.4.123: Antworten an den Kontakt des Betreibers (wenn er eine E-Mail-Adresse ist), nicht an den Absender
+    kontakt = (angaben(db).server_contact or "").strip()
     try:
-        _email(replace(k, email_an=an), betreff, text)
+        _email(replace(k, email_an=an), betreff, text, antwort_an=kontakt if gueltig(kontakt) else None)
     except VersandFehler as e:
         log.warning("Mail an Konto nicht zugestellt: %s", e)
