+
     def log_ende(self, zeilen: int = 60) -> list[str]:
         try:
@@ -103,7 +107,8 @@ class LokalerKnecht:
             log.write(f"\n===== {utcnow():%Y-%m-%d %H:%M} UTC – Start ({modus}) =====\n")
             log.flush()
+            self.stoppdatei.unlink(missing_ok=True)
