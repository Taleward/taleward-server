+    aus: list[str] = []
+    for text in (campaign.title or "", (campaign.world_info or "")[:4000]):
+        for w in _WORT.findall(text):
+            if w[:1].isupper() and w.casefold() not in allgemein and w not in aus:
+                aus.append(w)
+    return aus[:WELT_NAMEN]
