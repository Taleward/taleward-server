+    meta_schreiben(dbs, "llm.api_key", "k" * 32)
+    dbs.add(Job(type="summarize", session_id=s["id"], required_capability="llm",
+                created_at=utcnow() - timedelta(hours=7)))
+    c = dbs.get(Campaign, w["cid"])
