+def _weniger_sichtbar(p: Proposal, e: Entry, public: bool, verborgen: list[str]) -> bool:
+    """Darf der Vorschlag Spieler erreichen, die den Eintrag sehen? Nein, wenn er gm_only ist oder vor Personen
