diff --git a/app/verwaltung/templates/abrechnung.html b/app/verwaltung/templates/abrechnung.html
new file mode 100644
index 0000000..b51f778
--- /dev/null
+++ b/app/verwaltung/templates/abrechnung.html
@@ -0,0 +1,133 @@
+{% extends "basis.html" %}
+{% block titel %}{{ _("Abrechnung") }}{% endblock %}
+{% block inhalt %}
+{% set arten = {"zahlung": _("Zahlung"), "gutschrift": _("Gutschrift"), "gutschein": _("Gutschein"), "verbrauch": _("Verarbeitung"), "rueckbuchung": _("Rückbuchung"), "erstattung": _("Erstattung"), "korrektur": _("Korrektur")} %}
+<h1>{{ _("Abrechnung") }}</h1>
+<p class="leise">{{ _("Wer verarbeiten lässt, zahlt aus einem Guthaben. Spieler zahlen nie. Aufladen mit Bezahlung kommt in einer späteren Fassung; bis dahin gibt es Gutschriften und Gutscheine.") }}</p>
+
+{% if codes %}
+<div class="karte" id="codes">
+  <h2>{{ _("Neue Gutscheine: {aktion}", aktion=codes.aktion) }}</h2>
+  <p>{{ _("Je {betrag}. Die Codes werden nur jetzt angezeigt – kopiere sie jetzt. Jeder gilt einmal.", betrag=codes.betrag) }}</p>
+  <ul class="codeliste">{% for c in codes.liste %}<li><code>{{ c }}</code></li>{% endfor %}</ul>
+</div>
+{% endif %}
+
+{% if bestaetigen %}
+<div class="karte" id="bestaetigen">
+  <h2>{{ _("Gutschrift bestätigen") }}</h2>
+  <p>{{ _("{betrag} für {name} gutschreiben. Grund: {grund}", betrag=bestaetigen.betrag, name=bestaetigen.name, grund=bestaetigen.grund) }}</p>
+  <form class="formular" method="post" action="/verwaltung/abrechnung/gutschrift">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    <input type="hidden" name="ziel_konto" value="{{ bestaetigen.ziel_konto }}"><input type="hidden" name="ziel_org" value="{{ bestaetigen.ziel_org }}">
+    <input type="hidden" name="betrag" value="{{ bestaetigen.roh }}"><input type="hidden" name="grund" value="{{ bestaetigen.grund }}">
+    <label class="haken"><input type="checkbox" name="bestaetigt" value="1" required> {{ _("Ja, so gutschreiben. Das steht danach dauerhaft im Buchungsbuch.") }}</label>
+    <div class="aktionen"><button class="tw-btn tw-btn--primary" type="submit">{{ _("Gutschreiben") }}</button> <a href="/verwaltung/abrechnung">{{ _("Abbrechen") }}</a></div>
+  </form>
+</div>
+{% endif %}
+
+<div class="karte">
+  <h2>{{ _("Schalter") }}</h2>
+  <form class="formular" method="post" action="/verwaltung/abrechnung/modus">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    {% for wert, text in [("aus", _("Aus – alles wie bisher, nichts wird abgerechnet")), ("guthaben", _("Guthaben je Spielleitung")), ("topf", _("Topf der Organisation (zahlt für ihre Kampagnen)"))] %}
+    <label class="haken"><input type="radio" name="modus" value="{{ wert }}" {% if modus == wert %}checked{% endif %}> {{ text }}</label>
+    {% endfor %}
+    <p class="hilfe">{{ _("Eingeschaltet sehen Spielleitungen ihr Guthaben unter /guthaben auf diesem Server. Die monatliche Kostengrenze unter Einstellungen bleibt als Notbremse.") }}</p>
+    <div><button class="tw-btn tw-btn--secondary" type="submit">{{ _("Speichern") }}</button></div>
+  </form>
+</div>
+
+<div class="karte">
+  <h2>{{ _("Preise und Grenzen") }}</h2>
+  <p class="hilfe">{{ _("Cloud-Kosten werden so abgerechnet, wie sie anfallen, plus Aufschlag. Die Cloud-Werte hier dienen nur der Schätzung vor dem Start. Worker-Arbeit kostet, was du hier festlegst, gemessen an der Länge der Aufnahme bzw. den Seiten.") }}</p>
+  <form class="formular" method="post" action="/verwaltung/abrechnung/preise">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    {% for name, text, ist_euro in preisfelder %}
+    <label>{{ _(text) }} <input type="text" name="{{ name }}" value="{{ euro_feld(werte[name]) if ist_euro else werte[name] }}" inputmode="decimal" required maxlength="12"></label>
+    {% endfor %}
+    <div><button class="tw-btn tw-btn--secondary" type="submit">{{ _("Speichern") }}</button></div>
+  </form>
+</div>
+
+{% if an %}
+<div class="karte">
+  <h2>{{ _("Guthaben") }}</h2>
+  <div class="tabelle-huelle"><table>
+    <thead><tr><th>{{ _("Wer") }}</th><th>{{ _("Saldo") }}</th></tr></thead>
+    <tbody>
+    {% for k in konten %}
+      <tr><td data-label="{{ _('Wer') }}">{{ k.name }}{% if k.g.art == "organisation" %} <span class="leise">({{ _("Organisation") }})</span>{% endif %}</td><td data-label="{{ _('Saldo') }}">{{ euro(k.saldo) }}</td></tr>
+    {% else %}
+      <tr><td colspan="2" class="leise">{{ _("Noch kein Guthaben angelegt.") }}</td></tr>
+    {% endfor %}
+    </tbody>
+  </table></div>
+</div>
+
+<div class="karte">
+  <h2>{{ _("Gutschrift von Hand") }}</h2>
+  {% if not faktor %}<div class="meldung meldung--fehler">{{ _("Gutschriften und Gutscheine gehen nur mit eingeschaltetem zweiten Faktor (Konten → Dein zweiter Faktor).") }}</div>{% endif %}
+  <form class="formular" method="post" action="/verwaltung/abrechnung/gutschrift">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    <label>{{ _("Benutzername") }} <input type="text" name="ziel_konto" maxlength="64" autocomplete="off"></label>
+    {% if modus == "topf" %}
+    <label>{{ _("oder Organisation") }} <select name="ziel_org"><option value="">–</option>{% for o in orgs %}<option value="{{ o.id }}">{{ o.name }}</option>{% endfor %}</select></label>
+    {% endif %}
+    <label>{{ _("Betrag (Euro)") }} <input type="text" name="betrag" inputmode="decimal" required maxlength="12"></label>
+    <label>{{ _("Grund") }} <input type="text" name="grund" required maxlength="500"></label>
+    <div><button class="tw-btn tw-btn--secondary" type="submit" {% if not faktor %}disabled{% endif %}>{{ _("Weiter") }}</button></div>
+  </form>
+  {% if gutschriften %}
+  <h3>{{ _("Letzte Gutschriften") }}</h3>
+  <ul class="liste-av">
+  {% for z in gutschriften %}
+    <li><span>{{ zeit(z.b.angelegt) }} · {{ z.name }} · {{ euro(z.b.betrag_cent) }} · <span class="leise">{{ z.b.grund }}</span></span>
+      <details><summary>{{ _("Stornieren") }}</summary>
+        <form class="formular formular--zeile" method="post" action="/verwaltung/abrechnung/storno/{{ z.b.id }}">
+          <input type="hidden" name="csrf" value="{{ csrf }}">
+          <label class="haken"><input type="checkbox" name="bestaetigt" value="1" required> {{ _("Gegenbuchung über denselben Betrag anlegen") }}</label>
+          <button class="tw-btn tw-btn--secondary tw-btn--klein" type="submit" {% if not faktor %}disabled{% endif %}>{{ _("Stornieren") }}</button>
+        </form></details></li>
+  {% endfor %}
+  </ul>
+  {% endif %}
+</div>
+
+<div class="karte">
+  <h2>{{ _("Gutscheine") }}</h2>
+  <form class="formular" method="post" action="/verwaltung/abrechnung/gutscheine">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    <label>{{ _("Aktion (z. B. Verlosung Oktober)") }} <input type="text" name="aktion" required maxlength="100"></label>
+    <label>{{ _("Anzahl (1–100)") }} <input type="number" name="anzahl" value="1" min="1" max="100" required></label>
+    <label>{{ _("Betrag je Gutschein (Euro)") }} <input type="text" name="betrag" inputmode="decimal" required maxlength="12"></label>
+    <label>{{ _("Gültig bis (leer = ohne Ablauf)") }} <input type="date" name="gueltig_bis"></label>
+    <p class="hilfe">{{ _("Je Konto gilt höchstens ein Gutschein derselben Aktion.") }}</p>
+    <label class="haken"><input type="checkbox" name="bestaetigt" value="1" required> {{ _("Gutscheine jetzt erzeugen") }}</label>
+    <div><button class="tw-btn tw-btn--secondary" type="submit" {% if not faktor %}disabled{% endif %}>{{ _("Erzeugen") }}</button></div>
+  </form>
+  {% if aktionen %}
+  <div class="tabelle-huelle"><table>
+    <thead><tr><th>{{ _("Aktion") }}</th><th>{{ _("Betrag") }}</th><th>{{ _("Eingelöst") }}</th><th>{{ _("Gültig bis") }}</th></tr></thead>
+    <tbody>
+    {% for a in aktionen %}
+      <tr><td data-label="{{ _('Aktion') }}">{{ a[0] }}</td><td data-label="{{ _('Betrag') }}">{{ euro(a[1]) }}</td><td data-label="{{ _('Eingelöst') }}">{{ _("{n} von {gesamt}", n=a[3], gesamt=a[2]) }}</td><td data-label="{{ _('Gültig bis') }}">{{ zeit(a[4]) if a[4] else "–" }}</td></tr>
+    {% endfor %}
+    </tbody>
+  </table></div>
+  {% endif %}
+</div>
+{% endif %}
+
+<div class="karte">
+  <h2>{{ _("Protokoll") }}</h2>
+  <ul class="liste-av">
+  {% for p in protokoll %}
+    <li><span>{{ zeit(p.z.angelegt) }} · {{ p.von }} · <strong>{{ p.z.was }}</strong> <span class="leise">{{ p.daten }}</span></span></li>
+  {% else %}
+    <li class="leise">{{ _("Noch keine Einträge.") }}</li>
+  {% endfor %}
+  </ul>
+</div>
+{% endblock %}
