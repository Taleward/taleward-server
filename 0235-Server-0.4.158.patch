+def _vormerken(db: Session, v: Bezahlvorgang, cent: int, erneut: bool) -> bool:
+    """S64: Erstattung je Zahlung vormerken, bevor sie beim Anbieter angestoßen wird. Steht schon eine aus (Meldung des
