diff --git a/app/aktualisierung.py b/app/aktualisierung.py
index 382f96f..7d90928 100644
--- a/app/aktualisierung.py
+++ b/app/aktualisierung.py
@@ -521,4 +521,15 @@ def download_pfad(art: str, s: dict) -> str:
 
 
+# GitHubs „latest“ zeigt beim Worker nicht auf die neueste Fassung (Freigaben ohne „latest“) – nie darauf verlinken
+WORKER_RELEASES = "https://github.com/Taleward/taleward-worker/releases"
+
+
+def worker_link(db: Session) -> str:
+    """Download des Windows-Workers für die Verwaltung: die freigegebene Fassung von diesem Server, sonst die
+    Release-Seite auf GitHub."""
+    s = freigegeben(db, "worker-windows")
+    return download_pfad("worker-windows", s) if s else WORKER_RELEASES
+
+
 def angebot(db: Session, art: str, basis: str) -> dict | None:
     """Freigegebene Fassung mit Download-Adresse auf diesem Server (für App-Info und Worker)."""
diff --git a/app/cli.py b/app/cli.py
index ef7995b..207f9f8 100644
--- a/app/cli.py
+++ b/app/cli.py
@@ -97,4 +97,37 @@ def reset_password(username: str = typer.Option(..., "--username", "-u")):
 
 
+@app.command("verwalter")
+def verwalter_zeigen():
+    """Benutzernamen aller Verwalter, einer je Zeile (für „Passwort vergessen“ im Taleward-Programm)."""
+    from app.models import OrgMember, User as Konto
+
+    db = _db()
+    namen = db.scalars(select(Konto.username).join(OrgMember, OrgMember.user_id == Konto.id)
+                       .where(OrgMember.role == "admin", Konto.setup_account.is_(False)).distinct()
+                       .order_by(Konto.username))
+    for name in namen:
+        typer.echo(name)
+
+
+@app.command("passwort-neu")
+def passwort_neu(username: str = typer.Option(..., "--username", "-u")):
+    """Neues Passwort aus der Standardeingabe (eine Zeile, nie als Argument). Alle Anmeldungen dieses Kontos werden
+    ungültig. Für „Passwort vergessen“ im Taleward-Programm; von Hand geht auch `reset-password`."""
+    db = _db()
+    user = db.scalar(select(User).where(User.username == username.strip().lower()))
+    if user is None:
+        typer.echo("Benutzer nicht gefunden.", err=True)
+        raise typer.Exit(1)
+    pw = _passwort_lesen()
+    if len(pw) < 8:
+        typer.echo("Das Passwort muss mindestens 8 Zeichen haben.", err=True)
+        raise typer.Exit(2)
+    from app import passwortlink
+
+    passwortlink.passwort_setzen(db, user, pw)
+    db.commit()
+    typer.echo("Passwort geändert.")
+
+
 @app.command("list-users")
 def list_users():
