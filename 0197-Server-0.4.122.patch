From 4483663e35d85a75fb3ea552fa6eeb9c65eff147 Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Thu, 22 Oct 2026 13:28:26 +0200
Subject: [PATCH] Server 0.4.122
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Website neben dem Server: Snippets aus derselben Regeldatei erlaubt, Kommentare werden nicht geprüft, ohne
Regeldatei ändert neu-laden nichts. Nutzer für das Hochladen heißt taleward-website.
---
 deploy/website-neu-laden.sh  |  20 +++++--
 deploy/website-zugang.sh     |   6 +-
 docs/BETRIEB.md              |  11 ++--
 pyproject.toml               |   2 +-
 tests/test_aktualisierung.py |   2 +-
 tests/test_assistent.py      |   2 +-
 tests/test_modellablage.py   |   2 +-
 tests/test_server_04121.py   | 110 ++++++++++++++++++++++++++++++++++-
 tests/test_worker_app.py     |   2 +-
 uv.lock                      |   2 +-
 10 files changed, 139 insertions(+), 20 deletions(-)

diff --git a/deploy/website-neu-laden.sh b/deploy/website-neu-laden.sh
index dd70509..cc79da3 100755
--- a/deploy/website-neu-laden.sh
+++ b/deploy/website-neu-laden.sh
@@ -16,12 +16,17 @@ regeln_pruefen() {
     return 1
   fi
-  # Nichts, was über statisches Ausliefern hinausgeht: keine weiteren Dateien einbinden, nichts weiterleiten,
-  # keine Platzhalter für Umgebung oder Dateien, keine Protokolle, Zertifikate oder Verwaltung, kein „..“
-  if grep -nEi '(^|[[:space:]])(import|reverse_proxy|php_fastcgi|forward_auth|fs|storage|admin|acme_ca|acme_dns|tls|log|templates|invoke|metrics|tracing)([[:space:]]|\{|$)|\{(env|file|system)\.|\{\$|\.\.' "$datei" >&2; then
+  # Geprüft wird ohne Kommentarzeilen. Nichts, was über statisches Ausliefern hinausgeht: nichts weiterleiten, keine
+  # Platzhalter für Umgebung oder Dateien, keine Protokolle, Zertifikate oder Verwaltung, kein „..“; „import“ nur für
+  # Snippets aus derselben Datei (ein Name, kein Pfad)
+  local inhalt
+  inhalt=$(grep -nvE '^[[:space:]]*#' "$datei" || true)
+  if grep -Ei '(^|[[:space:]:])(reverse_proxy|php_fastcgi|forward_auth|fs|storage|admin|acme_ca|acme_dns|tls|log|templates|invoke|metrics|tracing)([[:space:]]|\{|$)|\{(env|file|system)\.|\{\$|\.\.' <<<"$inhalt" >&2 \
+     || grep -E '^[0-9]+:[[:space:]]*import([[:space:]]|$)' <<<"$inhalt" \
+        | grep -vE '^[0-9]+:[[:space:]]*import[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*$' >&2; then
     echo "Abgelehnt: $(basename "$datei") enthält nicht erlaubte Angaben (Zeilen oben)." >&2
     return 1
   fi
   # „root“ nur innerhalb des Website-Ordners
-  if grep -nE '^[[:space:]]*root([[:space:]]|$)' "$datei" \
+  if grep -E '^[0-9]+:[[:space:]]*root([[:space:]]|$)' <<<"$inhalt" \
      | grep -vE ":[[:space:]]*root([[:space:]]+(\*|@[A-Za-z0-9_-]+|/[^[:space:]]*))?[[:space:]]+$WURZEL(/[^[:space:]]*)?[[:space:]]*$" >&2; then
     echo "Abgelehnt: „root“ muss in $WURZEL liegen (Zeilen oben)." >&2
@@ -50,5 +55,10 @@ for f in "$ORDNER"/_caddy/*.caddy; do
   cp -P -- "$f" "$NEU/"
 done
-for f in "$NEU"/*; do
+NEUE=("$NEU"/*)
+if [ "${#NEUE[@]}" -eq 0 ]; then
+  echo "Keine Caddy-Regeln gefunden ($ORDNER/_caddy/*.caddy) – nichts geändert." >&2
+  exit 1
+fi
+for f in "${NEUE[@]}"; do
   regeln_pruefen "$f"
 done
diff --git a/deploy/website-zugang.sh b/deploy/website-zugang.sh
index 880295a..82b7247 100755
--- a/deploy/website-zugang.sh
+++ b/deploy/website-zugang.sh
@@ -1,5 +1,5 @@
 #!/bin/bash
 # Optional, einmalig: eine statische Website neben dem Server über denselben Caddy ausliefern
-# (docs/BETRIEB.md, „Website mitliefern“). Legt den Nutzer „website“ an, der per SSH genau zweierlei darf:
+# (docs/BETRIEB.md, „Website mitliefern“). Legt den Nutzer „taleward-website“ an, der per SSH genau zweierlei darf:
 # Dateien in den Website-Ordner hochladen (rsync, nur dorthin) und „neu-laden“ (Caddy-Regeln prüfen und übernehmen).
 # Aufruf auf dem Server:  sudo bash /opt/taleward/website-zugang.sh
@@ -7,5 +7,5 @@
 set -euo pipefail
 ZIEL=${TALEWARD_ZIEL:-/opt/taleward}
-NUTZER=website
+NUTZER=${WEBSITE_NUTZER:-taleward-website}
 EMPFANG=/usr/local/bin/taleward-website-empfang
 NEULADEN=/usr/local/sbin/taleward-website-neu-laden
@@ -74,4 +74,4 @@ echo "  Adresse:        ${IP:-<IP dieses Servers>}"
 echo "  Nutzer:         $NUTZER"
 echo "  known_hosts:    ${IP:-<IP>} $(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)"
-echo "Hochladen:  rsync -rlz --delete --delay-updates dist/ $NUTZER@${IP:-<IP>}:"
+echo "Hochladen:  rsync -rlt --delete --delay-updates dist/ $NUTZER@${IP:-<IP>}:"
 echo "Neu laden:  ssh $NUTZER@${IP:-<IP>} neu-laden"
diff --git a/docs/BETRIEB.md b/docs/BETRIEB.md
index 7125554..960e3d8 100644
--- a/docs/BETRIEB.md
+++ b/docs/BETRIEB.md
@@ -244,12 +244,15 @@ Wer neben dem Server eine statische Website betreibt, kann sie über denselben C
 
 1. Auf dem Server einmal `sudo bash /opt/taleward/website-zugang.sh`. Das Skript fragt nach dem Ordner (Vorschlag
-   `/srv/website`) und nach dem öffentlichen SSH-Schlüssel, mit dem hochgeladen wird. Es legt den Nutzer `website` an,
+   `/srv/website`) und nach dem öffentlichen SSH-Schlüssel, mit dem hochgeladen wird. Es legt den Nutzer `taleward-website` an,
    der per SSH nur zweierlei darf: mit `rsync` in genau diesen Ordner schreiben und `neu-laden`. Am Ende zeigt es die
    Angaben für das Hochladen (Adresse, `known_hosts`-Zeile).
-2. Hochladen: `rsync -rlz --delete --delay-updates dist/ website@SERVER:` und danach `ssh website@SERVER neu-laden`.
+2. Hochladen: `rsync -rlt --delete --delay-updates dist/ taleward-website@SERVER:` und danach
+   `ssh taleward-website@SERVER neu-laden`.
 3. Die Website bringt ihre Caddy-Regeln selbst mit: Dateien `_caddy/*.caddy` im hochgeladenen Ordner, mit
    Site-Blöcken für ihre Domains (ohne globalen Block). Caddy sieht den Ordner als `/srv/website`; `root` muss darin
-   liegen. Erlaubt ist nur statisches Ausliefern (Kopfzeilen, Umleitungen, Antworten, `file_server` usw.) – nicht
-   erlaubt sind u. a. `import`, `reverse_proxy`, `log`, `tls`, `templates` und Platzhalter für Umgebung oder Dateien.
+   liegen (als feste Angabe, z. B. `root * /srv/website`). Erlaubt ist nur statisches Ausliefern (Kopfzeilen,
+   Umleitungen, Antworten, `file_server`, Snippets aus derselben Datei usw.) – nicht erlaubt sind u. a. `import` von
+   Dateien, `reverse_proxy`, `log`, `tls`, `templates` und Platzhalter für Umgebung oder Dateien. Ohne Regeldatei ändert
+   `neu-laden` nichts.
    `neu-laden` prüft die Regeln, übernimmt sie und lädt Caddy ohne Neustart neu. Lehnt Caddy sie ab, bleiben die
    bisherigen in Betrieb, und der Befehl endet mit einem Fehler. Den Ordner `_caddy` selbst sollte die Website mit
