-# whisperx 3.8.6 verlangt torch 2.8; die KI-Pakete laufen auf dem neueren PyTorch (geprüft im Probelauf), das bekannte
-# Lücken schließt. torchaudio, torchvision und torchcodec passen zu dieser torch-Fassung; alle vier gibt es im
-# PyTorch-Verzeichnis für cu128 (Worker-App, Dockerfile.worker), und torch von PyPI bringt dieselben CUDA-12.8-
-# Bibliotheken mit wie das Verzeichnis.
+# whisperx 3.8.6 verlangt torch 2.8 und huggingface-hub unter 1.0; die KI-Pakete laufen auf den neueren Fassungen
+# (geprüft im Probelauf), die bekannte Lücken in torch und transformers schließen. torchaudio, torchvision und
+# torchcodec passen zu dieser torch-Fassung; alle vier gibt es im PyTorch-Verzeichnis für cu128 (Worker-App,
+# Dockerfile.worker), und torch von PyPI bringt dieselben CUDA-12.8-Bibliotheken mit wie das Verzeichnis.
 [tool.uv]
 override-dependencies = [
@@ -69,4 +70,5 @@ override-dependencies = [
     "torchvision==0.25.0",
     "torchcodec==0.10.0",
+    "huggingface-hub>=1.0",
 ]
 
